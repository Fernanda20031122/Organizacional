<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Organizacional</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Organizacional.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body>
<div class="row g-0">
    <div class="col">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- 🔹 Modal de advertencia de sesión -->
    <div class="modal fade" id="sessionWarningModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">⚠️ Sesión por expirar</h5>
                </div>
                <div class="modal-body">
                    Tu sesión expirará en <b>2 minutos</b> por inactividad.<br />
                    ¿Deseas seguir conectado?
                </div>
                <div class="modal-footer">
                    <button type="button" id="stayLoggedInBtn" class="btn btn-primary" data-bs-dismiss="modal">
                        Seguir conectado
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ⚡ Configuración
        const warningTime = 28 * 60 * 1000; // 28 minutos
        const logoutTime = 30 * 60 * 1000; // 30 minutos

        let warningTimer, logoutTimer;

        function resetSessionTimers() {
            clearTimeout(warningTimer);
            clearTimeout(logoutTimer);

            // Mostrar modal a los 28 minutos
            warningTimer = setTimeout(() => {
                var modal = new bootstrap.Modal(document.getElementById('sessionWarningModal'));
                modal.show();
            }, warningTime);

            // Redirigir al login a los 30 minutos
            logoutTimer = setTimeout(() => {
                window.location.href = '@Url.Action("Logout", "Auth")';
            }, logoutTime);
        }

        // Escuchar actividad del usuario
        document.addEventListener('mousemove', resetSessionTimers);
        document.addEventListener('keydown', resetSessionTimers);

        // Acción al hacer clic en "Seguir conectado"
        document.getElementById("stayLoggedInBtn").addEventListener("click", () => {
            fetch('@Url.Action("KeepAlive", "Auth")', {
                method: "POST"
            })
            .then(r => r.json())
            .then(() => {
                resetSessionTimers(); // 🔄 reinicia contadores del modal
            })
            .catch(err => console.error("Error renovando sesión:", err));
        });

        // Iniciar timers cuando carga la página
        resetSessionTimers();
    </script>
</div>
    @{
        var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
        var action     = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();

        // No mostrar en Auth (Login, TwoFactor, Forgot, etc.)
        var hideOnAuth = controller == "auth";

        // Opcional: tampoco mostrar cuando ya estás en el Dashboard/Index
        var isDashboardHome = controller == "dashboard" && action == "index";
        var isDashboardHistorial = controller == "dashboard" && action == "historial";
    }

    @if (!hideOnAuth && !isDashboardHome && !isDashboardHistorial)
    {
        <!-- Botón flotante: ir siempre al Dashboard -->
        <a href="@Url.Action("Index","Dashboard")"
        class="btn btn-primary btn-lg rounded-circle shadow position-fixed"
        style="bottom:20px; right:20px; z-index:1000;"
        data-bs-toggle="tooltip" title="Ir al Dashboard">
            <i class="bi bi-arrow-left"></i> @* si prefieres, usa bi-house *@
        </a>
    }
</body>
</html>
