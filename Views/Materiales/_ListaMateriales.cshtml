@model List<Organizacional.Models.MaterialesPendiente>

<div class="modal fade" id="modalListaMateriales" tabindex="-1" aria-labelledby="modalListaMaterialesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalListaMaterialesLabel">Materiales solicitados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form method="post" action="@Url.Action("ActualizarEntregaMateriales", "Materiales")">
                    <input type="hidden" name="idDocumento" value="@Model.FirstOrDefault()?.IdDocumento" />

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Entregado</th>
                                <th>Material</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="materialesEntregados"
                                               value="@m.Id"
                                               @(m.MaterialEntregado ? "checked" : "") />
                                    </td>
                                    <td>@m.NombreMaterial</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Asegúrate de tener estas referencias en la vista principal -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
