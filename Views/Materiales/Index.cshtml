@model IEnumerable<Organizacional.Models.ViewModels.MaterialesPorEntregarViewModel>

@{
    ViewData["Title"] = "Materiales por Entregar";
    Layout = null; // 👈 igual que en Dashboard
}

@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");
    var rolUsuario = Context.Session.GetInt32("Rol");
}

@if (idUsuario == null || rolUsuario == null)
{
    <script>window.location.href = '/Auth/Login';</script>
}

@await Html.PartialAsync("_Sidebar")

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="row g-0">
        <div class="col-md-9 col-lg-10 p-4 contenido" style="margin-left: 240px;">
            <h2>Materiales por Entregar</h2>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tipo de Documento</th>
                        <th>Tipo de Servicio</th>
                        <th>Empresa</th>
                        <th>Fecha de Solicitud</th>
                        <th>Técnico</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NumeroDocumento</td>
                            <td>@item.Tipo</td>
                            <td>
                                @if (item.Suministro)
                                {
                                    <i class="bi bi-box-seam text-primary me-1" data-bs-toggle="tooltip" title="Suministro"></i>
                                }
                                @if (item.Instalacion)
                                {
                                    <i class="bi bi-tools text-success me-1" data-bs-toggle="tooltip" title="Instalación"></i>
                                }
                                @if (item.Mantenimiento)
                                {
                                    <i class="bi bi-wrench-adjustable text-warning me-1" data-bs-toggle="tooltip" title="Mantenimiento"></i>
                                }
                                @if (item.Soporte)
                                {
                                    <i class="bi bi-laptop text-dark me-1" data-bs-toggle="tooltip" title="Soporte"></i>
                                }
                            </td>
                            <td>@item.EmpresaNombre</td>
                            <td>
                                @if(item.FechaRegistro.HasValue)
                                {
                                    @item.FechaRegistro.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span>--</span>
                                }
                            </td>
                            <td>@item.TecnicoAsignado</td>
                            <td>
                                <button class="btn btn-primary btn-sm"
                                        onclick="verMateriales(@item.IdPendiente)">
                                    Ver materiales
                                </button>
                                <a href="@Url.Action("Detalle", "Dashboard", new { id = item.IdPendiente })" 
                                   class="btn btn-success btn-sm mt-2">
                                    Abrir Detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Aquí se cargará dinámicamente el modal -->
    <div id="contenedorModal"></div>

    <!-- Bootstrap 5 JS (sin jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function verMateriales(idPendiente) {
            fetch('/Materiales/ListaMateriales?idPendiente=' + idPendiente)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenedorModal').innerHTML = html;

                    // Inicializar el modal cargado
                    var modalEl = document.getElementById('modalListaMateriales');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                });
        }

        // 👇 Igual que en Dashboard (hamburguesa responsive)
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('hamburgerBtn');
            const sidebar = document.querySelector('.sidebar');

            if (btn && sidebar) {
                btn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                });

                document.addEventListener('click', function (event) {
                    if (
                        sidebar.classList.contains('show') &&
                        !sidebar.contains(event.target) &&
                        event.target !== btn
                    ) {
                        sidebar.classList.remove('show');
                    }
                });
            }
        });
    </script>

</body>
</html>
