@model List<Organizacional.Models.ViewModels.DashboardItemViewModel>
@{
    ViewData["Title"] = "Dashboard Pendientes";
    Layout = null;
}
@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");
    var rolUsuario = Context.Session.GetInt32("Rol");
}

@if (idUsuario == null || rolUsuario == null)
{
    <script>window.location.href = '/Auth/Login';</script>
}

@await Html.PartialAsync("_Sidebar")

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="row g-0">
        <div class="col-md-9 col-lg-10 p-4 contenido" style="margin-left: 240px;">
            <h2>@ViewData["Title"]</h2>

            <!-- Filtros -->
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Empresa</label>

                    @if (ViewBag.EsCliente == true) 
                    {
                        <!-- Cliente: solo su empresa -->
                        <input type="text" class="form-control" value="@ViewBag.EmpresaSeleccionada" readonly />
                        <input type="hidden" name="empresa" value="@ViewBag.EmpresaSeleccionada" />
                    }
                    else
                    {
                        <!-- Admin/otros: lista desplegable -->
                        <select name="empresa" class="form-select">
                            <option value="">-- Todas --</option>
                            @foreach (string emp in (ViewBag.Empresas as List<string> ?? new List<string>()))
                            {
                                if (ViewBag.EmpresaSeleccionada == emp)
                                {
                                    <option value="@emp" selected="selected">@emp</option>
                                }
                                else
                                {
                                    <option value="@emp">@emp</option>
                                }
                            }
                        </select>
                    }
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="Pendiente" selected="@(Context.Request.Query["estado"] == "Pendiente")">Pendiente</option>
                        <option value="En_Proceso" selected="@(Context.Request.Query["estado"] == "En_Proceso")">En Proceso</option>
                        <option value="Completado" selected="@(Context.Request.Query["estado"] == "Completado")">Completado</option>
                        <option value="Cancelado" selected="@(Context.Request.Query["estado"] == "Cancelado")">Cancelado</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Tipo de Servicio</label>
                    <select name="tipo" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="Suministro" selected="@(Context.Request.Query["tipo"] == "Suministro")">Suministro</option>
                        <option value="Instalacion" selected="@(Context.Request.Query["tipo"] == "Instalacion")">Instalación</option>
                        <option value="Mantenimiento" selected="@(Context.Request.Query["tipo"] == "Mantenimiento")">Mantenimiento</option>
                        <option value="Soporte" selected="@(Context.Request.Query["tipo"] == "Soporte")">Soporte</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>

            <!-- Tabla en pantallas grandes -->
            <div class="d-none d-md-block">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tipo Servicio</th>
                            <th>Empresa</th>
                            <th>Estado</th>
                            <th>Subido por</th>
                            <th>Días Transcurridos</th>
                            <th>Técnico</th>
                            <th>Fecha Ejecucion</th>
                            <th>Progreso</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-pendientes">
                        @Html.Partial("_PendientesTable", Model)
                    </tbody>
                </table>
            </div>

            <!-- Tarjetas en móviles -->
            <div class="tarjetas-dashboard d-block d-md-none mt-3">
                @foreach (var item in Model)
                {
                        var esAsignadoATi = item.TecnicoAsignado == Context.Session.GetString("NombreUsuario") ||
                                            item.ColaboradorAsignado == Context.Session.GetString("NombreUsuario");
                        var claseResaltado = esAsignadoATi ? "bg-warning-subtle border border-warning" : "";
                    
                    <div class="card shadow-sm mb-3">
                        <div class="p-3 rounded @claseResaltado">
                        <h5>#@item.NumeroDocumento - @item.EmpresaNombre</h5>
                        <p><strong>Tipo:</strong>
                            @if (item.Suministro) { <i class="bi bi-box-seam text-primary me-1"></i> }
                            @if (item.Instalacion) { <i class="bi bi-tools text-success me-1"></i> }
                            @if (item.Mantenimiento) { <i class="bi bi-wrench-adjustable text-warning me-1"></i> }
                        </p>
                        <p><strong>Estado:</strong>
                            @switch (item.Estado?.Trim().ToLower())
                            {
                                case "pendiente":
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    ; break;
                                case "en_proceso":
                                    <span class="badge bg-info text-dark">En Proceso</span>
                                    ; break;
                                case "completado":
                                    <span class="badge bg-success">Completado</span>
                                    ; break;
                                case "cancelado":
                                    <span class="badge bg-danger">Cancelado</span>
                                    ; break;
                                default:
                                    <span class="badge bg-secondary">Desconocido</span>
                                    ; break;
                            }
                        </p>
                        <p><strong>Subido por:</strong> @item.SubidoPor</p>
                        <p><strong>Días Transcurridos:</strong> @(item.Tipo == "Contrato" ? item.DiasTranscurridosContrato : item.DiasTranscurridos)</p>
                        <p><strong>Técnico:</strong> 
                        @item.TecnicoAsignado
                        @if (item.TecnicoAsignado == Context.Session.GetString("NombreUsuario") || 
                            item.ColaboradorAsignado == Context.Session.GetString("NombreUsuario"))
                        {
                            <span class="badge bg-primary ms-1">Asignado a ti</span>
                        }
                        </p>
                        <p><strong>Fecha Ejecución:</strong> 
                        @(item.FechaEjecucion.HasValue 
                            ? item.FechaEjecucion.Value.ToString("dd/MM/yyyy") 
                            : "Sin asignar")
                        </p>
                        <p><strong>Progreso:</strong>
                        @if (item.Tipo == "Contrato" && item.DiasTotalesContrato > 0)
                        {
                            var barraColor = item.PorcentajeProgreso >= 100 ? "bg-danger" :
                                            item.PorcentajeProgreso > 80 ? "bg-danger" :
                                            item.PorcentajeProgreso > 50 ? "bg-warning" : "bg-success";
                                            
                            <span class="d-inline-block" style="min-width: 40px;">
                            <div class="progress mb-1">
                                <div class="progress-bar @barraColor"
                                    role="progressbar"
                                    style="width:@item.PorcentajeProgreso%"
                                    aria-valuenow="@item.PorcentajeProgreso"
                                    aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            </span>
                            <p class="text-center small text-muted fw-semibold">
                                @item.PorcentajeProgreso% (@item.DiasTranscurridosContrato de @item.DiasTotalesContrato días)
                            </p>
                        }
                        else
                        {
                            <span>N/A</span>;
                        }
                        </p>
                        <a href="@Url.Action("Detalle", "Dashboard", new { id = item.IdDocumento })" class="btn btn-success btn-sm mt-2">Ver Detalle</a>
                    </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // Toggle del sidebar (tu código original)
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('hamburgerBtn');
            const sidebar = document.querySelector('.sidebar');

            if (btn && sidebar) {
                btn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                });

                document.addEventListener('click', function (event) {
                    if (
                        sidebar.classList.contains('show') &&
                        !sidebar.contains(event.target) &&
                        event.target !== btn
                    ) {
                        sidebar.classList.remove('show');
                    }
                });
            }
        });

        // Auto-actualización de la tabla (cada 15 s y al cambiar filtros)
        (function () {
            const $tbody   = document.getElementById('tbody-pendientes');
            const $empresa = document.getElementById('Empresa');       // puede ser select o hidden input
            const $estado  = document.getElementById('Estado');
            const $tipo    = document.getElementById('TipoServicio');
            const $buscar  = document.getElementById('btnBuscar');

            async function refreshTable() {
                const params = new URLSearchParams({
                    empresa: $empresa?.value || '',
                    estado:  $estado?.value  || '',
                    tipo:    $tipo?.value    || ''
                });
                const res = await fetch(`/Dashboard/PendientesTable?${params.toString()}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (res.ok) {
                    $tbody.innerHTML = await res.text();
                }
            }

            // cada 15 segundos
            setInterval(refreshTable, 15000);

            // al cambiar filtros o hacer clic en "Buscar" (evita full reload)
            [$empresa, $estado, $tipo].forEach(el => el?.addEventListener('change', e => {
                e?.preventDefault?.();
                refreshTable();
            }));
            $buscar?.addEventListener('click', e => { e.preventDefault(); refreshTable(); });
        })();
    </script>

</body>
</html>
