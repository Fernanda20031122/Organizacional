@model List<Organizacional.Models.ViewModels.DashboardItemViewModel>
@{
    ViewData["Title"] = "Historial Pendientes";
    Layout = "_Layout"; // 👈 Importante para que usemos la misma estructura que Dashboard
}

@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");
    var rolUsuario = Context.Session.GetInt32("Rol");
}

@if (idUsuario == null || rolUsuario == null)
{
    <script>window.location.href = '/Auth/Login';</script>
}

@await Html.PartialAsync("_Sidebar")

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Historial.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="row g-0">
        <!-- Contenido principal -->
        <div class="col-md-9 col-lg-10 p-4 contenido" style="margin-left: 240px;">
            <h2>@ViewData["Title"]</h2>
            <!-- Filtros -->
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Empresa</label>

                    @if (ViewBag.EsCliente == true) 
                    {
                        <!-- Cliente: solo su empresa -->
                        <input type="text" class="form-control" value="@ViewBag.EmpresaSeleccionada" readonly />
                        <input type="hidden" name="empresa" value="@ViewBag.EmpresaSeleccionada" />
                    }
                    else
                    {
                        <!-- Admin/otros: lista desplegable -->
                        <select name="empresa" class="form-select">
                            <option value="">-- Todas --</option>
                            @foreach (string emp in (ViewBag.Empresas as List<string> ?? new List<string>()))
                            {
                                if (ViewBag.EmpresaSeleccionada == emp)
                                {
                                    <option value="@emp" selected="selected">@emp</option>
                                }
                                else
                                {
                                    <option value="@emp">@emp</option>
                                }
                            }
                        </select>
                    }
                </div>
                
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="Completado" selected="@(Context.Request.Query["estado"] == "Completado")">Completado</option>
                        <option value="Cancelado" selected="@(Context.Request.Query["estado"] == "Cancelado")">Cancelado</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de Servicio</label>
                    <select name="tipo" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="Suministro" selected="@(Context.Request.Query["tipo"] == "Suministro")">Suministro</option>
                        <option value="Instalacion" selected="@(Context.Request.Query["tipo"] == "Instalacion")">Instalación</option>
                        <option value="Mantenimiento" selected="@(Context.Request.Query["tipo"] == "Mantenimiento")">Mantenimiento</option>
                        <option value="Soporte" selected="@(Context.Request.Query["tipo"] == "Soporte")">Soporte</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>

            <!-- Tabla en desktop -->
            <div class="d-none d-md-block">
                <table class="table table-bordered mt-4">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tipo de Documento</th>
                            <th>Tipo de Servicio</th>
                            <th>Empresa</th>
                            <th>Estado</th>
                            <th>Subido por</th>
                            <th>Fecha subida</th>
                            <th>Técnico Asignado</th>
                            <th>Fecha Cierre</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.TecnicoAsignado == Context.Session.GetString("NombreUsuario") ? "table-warning fw-bold" : "")">
                                <td>@item.NumeroDocumento</td>
                                <td>@item.Tipo</td>
                                <td>
                                    @if (item.Suministro)
                                    {
                                        <i class="bi bi-box-seam text-primary me-1" data-bs-toggle="tooltip" title="Suministro"></i>
                                    }
                                    @if (item.Instalacion)
                                    {
                                        <i class="bi bi-tools text-success me-1" data-bs-toggle="tooltip" title="Instalación"></i>
                                    }
                                    @if (item.Mantenimiento)
                                    {
                                        <i class="bi bi-wrench-adjustable text-warning me-1" data-bs-toggle="tooltip" title="Mantenimiento"></i>
                                    }
                                    @if (item.Soporte)
                                    {
                                        <i class="bi bi-laptop text-dark me-1" data-bs-toggle="tooltip" title="Soporte"></i>
                                    }
                                </td>
                                <td>@item.EmpresaNombre</td>
                                <td>
                                    @switch (item.Estado?.Trim().ToLower())
                                    {
                                        case "pendiente":
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                            break;
                                        case "en_proceso":
                                            <span class="badge bg-info text-dark">En Proceso</span>
                                            break;
                                        case "completado":
                                            <span class="badge bg-success">Completado</span>
                                            break;
                                        case "cancelado":
                                            <span class="badge bg-danger">Cancelado</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Desconocido</span>
                                            break;
                                    }
                                </td>
                                <td>@item.SubidoPor</td>
                                <td>@(item.FechaSubida == DateTime.MinValue ? "No registrada" : item.FechaSubida.ToString("dd/MM/yyyy"))</td>
                                <td>
                                    @item.TecnicoAsignado
                                    @if (item.TecnicoAsignado == Context.Session.GetString("NombreUsuario"))
                                    {
                                        <span class="badge bg-primary ms-1">Asignado a ti</span>
                                    }
                                </td>
                                <td>
                                    @(item.FechaCierre.HasValue
                                        ? item.FechaCierre.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "No registrada")
                                </td>
                                <td>
                                    <a href="@Url.Action("Detalle", "Dashboard", new { id = item.IdDocumento })" class="btn btn-success btn-sm mt-2">Ver Detalle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tarjetas en móviles -->
            <div class="tarjetas-historial d-block d-md-none mt-4">
                @foreach (var item in Model)
                {
                    <div class="card mb-3 p-3 shadow-sm @(item.TecnicoAsignado == Context.Session.GetString("NombreUsuario") ? "border-warning" : "")">
                        <h5>#@item.NumeroDocumento - @item.EmpresaNombre</h5>
                        <p><strong>Tipo:</strong>
                            @if (item.Suministro) { <i class="bi bi-box-seam text-primary me-1"></i> }
                            @if (item.Instalacion) { <i class="bi bi-tools text-success me-1"></i> }
                            @if (item.Mantenimiento) { <i class="bi bi-wrench-adjustable text-warning me-1"></i> }
                            @if (item.Soporte) { <i class="bi bi-laptop text-dark me-1"></i> }
                        </p>
                        <p><strong>Estado:</strong>
                            @switch (item.Estado?.Trim().ToLower())
                            {
                                case "pendiente":
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;
                                case "en_proceso":
                                    <span class="badge bg-info text-dark">En Proceso</span>
                                    break;
                                case "completado":
                                    <span class="badge bg-success">Completado</span>
                                    break;
                                case "cancelado":
                                    <span class="badge bg-danger">Cancelado</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Desconocido</span>
                                    break;
                            }
                        </p>
                        <p><strong>Subido por:</strong> @item.SubidoPor</p>
                        <p><strong>Fecha subida:</strong> @(item.FechaSubida == DateTime.MinValue ? "No registrada" : item.FechaSubida.ToString("dd/MM/yyyy"))</p>
                        <p><strong>Técnico:</strong> @item.TecnicoAsignado
                            @if (item.TecnicoAsignado == Context.Session.GetString("NombreUsuario"))
                            {
                                <span class="badge bg-primary ms-1">Asignado a ti</span>
                            }
                        </p>
                        <a href="@Url.Action("Detalle", "Dashboard", new { id = item.IdDocumento })" class="btn btn-success btn-sm mt-2">Ver Detalle</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tooltips
        const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltips.forEach(t => new bootstrap.Tooltip(t));

        // Sidebar toggle
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('hamburgerBtn');
            const sidebar = document.querySelector('.sidebar');

            if (btn && sidebar) {
                btn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                });

                document.addEventListener('click', function (event) {
                    if (
                        sidebar.classList.contains('show') &&
                        !sidebar.contains(event.target) &&
                        event.target !== btn
                    ) {
                        sidebar.classList.remove('show');
                    }
                });
            }
        });
    </script>
</body>
</html>
