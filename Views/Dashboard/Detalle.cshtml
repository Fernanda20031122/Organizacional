@model Organizacional.Models.ViewModels.DetalleDocumentoViewModel
@using System.Text.Json
@using System.Security.Claims

@{
    var esCliente = (ViewBag.EsCliente as bool?) ?? false;
}

@{
    ViewData["Title"] = "Detalle del Pendiente";
    Layout = "_Layout";
    var tecnico = Model.Tareas.FirstOrDefault()?.IdTecnicoAsignadoNavigation?.Nombre ?? "No asignado";
    var colaborador = Model.Tareas.FirstOrDefault()?.IdColaboradorAsignadoNavigation?.Nombre ?? "No asignado";
    var tieneMantenimientos = Model.Documento.Mantenimientos != null && Model.Documento.Mantenimientos.Any();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Detalle del Pendiente</h2>
    @if (!esCliente)
    {
        <a asp-action="Editar" asp-route-id="@Model.Documento.IdDocumento" class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Editar pendiente
        </a>
    }
</div>
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3 mb-4 shadow">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Informacion del Documento</h5>
    </div>
    <p><strong>Tipo:</strong> @Model.Documento.TipoDocumento</p>
    <p><strong>Número:</strong> @Model.Documento.NumeroDocumento</p>
    <p><strong>Descripción:</strong> @Model.Documento.Descripcion</p>
    <p><strong>Empresa:</strong> @Model.EmpresaNombre</p>
    <p><strong>Subido por:</strong> @Model.Documento.IdUsuarioSubioNavigation?.Nombre</p>
    <p>
        <strong>Fecha de subida:</strong>
        @(Model.Documento.FechaSubida.HasValue
                ? Model.Documento.FechaSubida.Value.ToDateTime(TimeOnly.MinValue).ToString("dd/MM/yyyy")
                : "No registrada")
    </p>

    @if (Model.Documento.TipoDocumento == "Contrato")
    {
        <p>
            <strong>Fecha Inicio:</strong>
            @(Model.Documento.FechaInicio.HasValue
                    ? Model.Documento.FechaInicio.Value.ToDateTime(TimeOnly.MinValue).ToString("dd/MM/yyyy")
                    : "No registrada")
                                  </p>
                                  <p>
                                      <strong>Fecha Fin:</strong>
            @(Model.Documento.FechaFin.HasValue
                    ? Model.Documento.FechaFin.Value.ToDateTime(TimeOnly.MinValue).ToString("dd/MM/yyyy")
                    : "No registrada")
    </p>
        }
    else
    {
        <p><strong>Fecha Generación:</strong> @Model.Documento.FechaGeneracion?.ToString("dd/MM/yyyy")</p>
    }

    <p>
        <strong>Servicios:</strong>
        @(Model.Documento.Suministro == true ? "Suministro " : "")
        @(Model.Documento.Instalacion == true ? "Instalación " : "")
        @(Model.Documento.Mantenimiento == true ? "Mantenimiento" : "")
        @(Model.Documento.Soporte == true ? "Soporte" : "")
    </p>
        <!-- ASIGNACIÓN -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Asignación</h5>
        </div>
        <div class="card-body">
            <p><strong>Técnico asignado:</strong> @tecnico</p>
            <p><strong>Colaborador asignado:</strong> @colaborador</p>

            <div class="d-flex gap-3 mt-3">
                @if (!esCliente)
                {
                    @if (tecnico == "No asignado" && (Model.Documento.Instalacion == true || Model.Documento.Mantenimiento == true || Model.Documento.Soporte == true))
                    {
                        <a asp-action="AsignarTecnico" asp-route-id="@Model.Documento.IdDocumento" class="btn btn-warning">
                            <i class="bi bi-person-gear"></i> Asignar Técnico
                        </a>
                    }
                    @if (colaborador == "No asignado")
                    {
                        <a asp-action="AsignarColaborador" asp-route-id="@Model.Documento.IdDocumento" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> Asignar Colaborador
                        </a>
                    }
                }
            </div>
        </div>
    </div>
    
        <!-- FECHA DE EJECUCIÓN -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Fecha de Ejecución</h5>
        </div>
        <div class="card-body">
            @if (!esCliente)
            {
                <form asp-action="ActualizarFechaEjecucion" asp-controller="Dashboard" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="idDocumento" value="@Model.Documento.IdDocumento" />

                    <input type="date"
                        name="fechaEjecucion"
                        class="form-control w-auto"
                        value="@(Model.Documento.FechaEjecucion?.ToString("yyyy-MM-dd") ?? "")" />

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar Fecha
                    </button>
                </form>
            }

            <p class="mt-2 text-muted">
                Fecha actual:
                <strong>
                    @(Model.Documento.FechaEjecucion.HasValue
                        ? Model.Documento.FechaEjecucion.Value.ToString("dd/MM/yyyy")
                        : "Sin asignar")
                </strong>
            </p>
        </div>
    </div>

    <!-- Mantenimientos -->
@if (tieneMantenimientos)
{
    <div id="mantenimientos-panel" data-doc="@Model.Documento.IdDocumento">
    <div class="text-muted py-2">Cargando mantenimientos…</div>
    </div>

    @section Scripts{
    <script>
    (() => {
    const root = document.getElementById('mantenimientos-panel');
    const id = root.dataset.doc;
    const url = '@Url.Action("Mantenimientos","Dashboard")' + '/' + id;

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(async r => {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        root.innerHTML = await r.text();
        })
        .catch(err => {
        root.innerHTML = `<div class="alert alert-warning">No se pudo cargar los mantenimientos (${err.message}).</div>`;
        });
    })();
    
    // Si en algún momento volvemos a aceptar "dd/mm/yyyy", estas funciones lo convierten.
    function toIsoDate(s){
        if(!s) return "";
        if(/^\d{4}-\d{2}-\d{2}$/.test(s)) return s; // ya es type=date
        const parts = s.trim().split(/[\/\-]/);
        if(parts.length === 3){
        const [d,m,y] = parts;
        return `${y.padStart(4,'0')}-${m.padStart(2,'0')}-${d.padStart(2,'0')}`;
        }
        return s;
    }

    function toIsoLocalDateTime(s){
        if(!s) return "";
        if(s.includes('T')) return s; // ya es type=datetime-local
        const [datePart, timePart="00:00"] = s.trim().split(/\s+/);
        return `${toIsoDate(datePart)}T${timePart.substring(0,5)}`;
    }

    async function savePlanned(btn, docId){
        const tr  = btn.closest('tr');
        const id  = tr.dataset.id;
        const raw = tr.querySelector('.planned').value;
        const iso = toIsoDate(raw);
        btn.disabled = true;
        try{
        const res = await fetch(`/Dashboard/${docId}/Mantenimientos/${id}/fecha`, {
            method:'POST',
            headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:`plannedDate=${encodeURIComponent(iso)}`
        });
        if(!res.ok) throw new Error(`HTTP ${res.status}`);
        btn.classList.remove('btn-outline-primary'); btn.classList.add('btn-primary');
        setTimeout(()=>{ btn.classList.remove('btn-primary'); btn.classList.add('btn-outline-primary'); }, 800);
        }catch(e){
        alert('No se pudo guardar la fecha: ' + e.message);
        }finally{ btn.disabled = false; }
    }

    async function completeMaint(btn, docId){
        const tr  = btn.closest('tr');
        const id  = tr.dataset.id;
        const raw = tr.querySelector('.completedAt').value || new Date().toISOString().slice(0,16);
        const iso = toIsoLocalDateTime(raw);
        btn.disabled = true;
        try{
        const res = await fetch(`/Dashboard/${docId}/Mantenimientos/${id}/completar`, {
            method:'POST',
            headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:`completedAt=${encodeURIComponent(iso)}`
        });
        if(!res.ok) throw new Error(`HTTP ${res.status}`);
        location.reload(); // refresca la badge
        }catch(e){
        alert('No se pudo completar: ' + e.message);
        }finally{ btn.disabled = false; }
    }
    </script>
    }
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Materiales y Herramientas</h5>
    </div>

    <div class="card-body">
        <h4 class="mt-4">🧾 Materiales solicitados</h4>
        @if (Model.Documento.MaterialesPendientes != null && Model.Documento.MaterialesPendientes.Any(m => m.EsSolicitado))
        {
            <form method="post" asp-action="ActualizarEntregaMateriales" asp-controller="Materiales" method="post">
                <input type="hidden" name="idDocumento" value="@Model.Documento.IdDocumento" />
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Nombre del material</th>
                            <th>Fecha</th>
                            <th>Entregado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Documento.MaterialesPendientes.Where(m => m.EsSolicitado))
                        {
                            <tr>
                                <td>@m.NombreMaterial</td>
                                <td>@m.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <input type="checkbox" name="materialesEntregados" value="@m.Id" @(m.MaterialEntregado ? "checked disabled" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-success mt-2">Guardar entregados</button>
            </form>
        }
        else
        {
            <p>No se han registrado materiales para este pendiente.</p>
        }

        <h4 class="mt-4">🧰 Herramientas dejadas en sitio</h4>
        @if (Model.Documento.HerramientaRecogida != null && Model.Documento.HerramientaRecogida.Any())
        {
        <form asp-action="ActualizarRecogidaHerramientas" asp-controller="Herramientas" method="post">
            <input type="hidden" name="idDocumento" value="@Model.Documento.IdDocumento" />
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Herramienta</th>
                        <th>Ubicación</th>
                        <th>Fecha</th>
                        <th>Dejada por</th>
                        <th>Recogida</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Documento.HerramientaRecogida)
                    {
                        <tr>
                            <td>@h.NombreHerramienta</td>
                            <td>@h.UbicacionDejado</td>
                            <td>@h.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@h.IdUsuarioNavigation?.Nombre</td>
                            <td>
                                <input type="checkbox" name="herramientasRecogidas" value="@h.Id" @(h.Recogida ? "checked disabled" : "") />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit"class="btn btn-success mt-2">Actualizar</button>
        </form>
        }
        else
        {
            <p>No se han registrado herramientas dejadas en este pendiente.</p>
        }

            <!-- BOTONES -->
            @if (!esCliente)
            {
                <div class="d-flex gap-3 mt-3">
                    <!-- Botón: Solicitar Materiales -->
                    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#formMateriales">Solicitar Materiales</button>

                    <!-- Botón: Registro herramienta en sitio -->
                    <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#formHerramientas">Registro herramienta en sitio</button>
                </div>

                <!-- FORMULARIO PARA SOLICITAR MATERIALES -->
                <div class="collapse" id="formMateriales">
                    <form asp-action="RegistrarMaterial" asp-controller="Materiales" method="post">
                        <input type="hidden" name="IdDocumento" value="@Model.Documento.IdDocumento" />
                        <div class="mb-2">
                            <label>Nombre del material</label>
                            <input type="text" name="NombreMaterial" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label>¿Es solicitado?</label>
                            <select name="EsSolicitado" class="form-control">
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">Solicitar</button>
                    </form>
                </div>

                <!-- FORMULARIO PARA REGISTRAR HERRAMIENTA -->
                <div class="collapse" id="formHerramientas">
                    <form asp-action="RegistrarHerramienta"asp-controller="Herramientas" method="post">
                        <input type="hidden" name="IdDocumento" value="@Model.Documento.IdDocumento" />
                        <input type="hidden" name="IdUsuario" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />

                        <div class="form-group">
                            <label>Nombre de la herramienta</label>
                            <input type="text" name="NombreHerramienta" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label>Ubicación donde se dejó</label>
                            <input type="text" name="UbicacionDejado" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary mt-2">Registrar herramienta</button>
                    </form>
                </div>
            }
    </div>
</div> 
<!-- CAMBIO DE ESTADO -->
@if (Model.Tareas != null && Model.Tareas.Any())
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Estado del Pendiente</h5>
        </div>
        <div class="card-body">
            @foreach (var tarea in Model.Tareas)
            {
                <div class="mb-3">
                    <p>
                        <strong>Estado actual:</strong>
                        <span class="badge
                            @(tarea.Estado == "pendiente" ? "bg-warning text-dark" :
                            tarea.Estado == "en_proceso" ? "bg-info text-dark" :
                            tarea.Estado == "completado" ? "bg-success" :
                            tarea.Estado == "cancelado" ? "bg-danger" : "bg-secondary")">
                            @tarea.Estado
                        </span>
                    </p>
                    @if (!esCliente)
                    {
                        <form asp-action="CambiarEstadoTarea" asp-controller="Dashboard" method="post" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="idTarea" value="@tarea.IdTarea" />
                            <select name="nuevoEstado" class="form-select w-auto">
                                @Html.Raw($"<option value='pendiente' {(tarea.Estado == "pendiente" ? "selected" : "")}>Pendiente</option>")
                                @Html.Raw($"<option value='en_proceso' {(tarea.Estado == "en_proceso" ? "selected" : "")}>En proceso</option>")
                                @Html.Raw($"<option value='completado' {(tarea.Estado == "completado" ? "selected" : "")}>Completado</option>")
                                @Html.Raw($"<option value='cancelado' {(tarea.Estado == "cancelado" ? "selected" : "")}>Cancelado</option>")
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Actualizar estado</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}
</div>   

@* Mostrar PDF y cotización solo si el usuario NO es técnico *@
@if (Context.Session.GetInt32("Rol") == 1) // Solo si NO es técnico
{
    <div class="row">
        <div class="col-md-6">
            <h4>Documento PDF</h4>
            @if (!string.IsNullOrEmpty(Model.Documento.ArchivoUrl))
            {
                <iframe src="@Model.Documento.ArchivoUrl" width="100%" height="500px"></iframe>
            }
            else
            {
                <p class="text-danger">No se ha subido un archivo para este documento.</p>
            }
        </div>

        <div class="col-md-6">
            <h4>Cotización PDF</h4>
            @if (!string.IsNullOrEmpty(Model.Documento.CotizacionArchivoUrl))
            {
                <iframe src="@Model.Documento.CotizacionArchivoUrl" width="100%" height="500px"></iframe>
            }
            else
            {
                <p class="text-warning">No se ha subido una cotización para este documento.</p>
            }
        </div>
    </div>
}