@model Organizacional.Models.Usuario

@{
    ViewData["Title"] = "Crear Técnico";
    Layout = "_Layout";
}
@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");
    var rolUsuario = Context.Session.GetInt32("Rol");
}

@if (idUsuario == null || rolUsuario == null)
{
    <script>window.location.href = '/Auth/Login';</script>
}

@await Html.PartialAsync("_Sidebar")

<div class="col-md-9 col-lg-10 p-4 contenido" style="margin-left: 240px;">
    <h2>Crear Técnico</h2>

    <form asp-action="CrearTecnico" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label">Correo electrónico</label>
            <input asp-for="Correo" type="email" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contrasena" class="form-label">Contraseña Provisional</label>
            <input asp-for="Contrasena" type="password" class="form-control" required />
            <span asp-validation-for="Contrasena" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Crear Técnico</button>
    </form>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</div>